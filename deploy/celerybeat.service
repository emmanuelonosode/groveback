[Unit]
Description=Celery Beat Scheduler (Hasker & Co.)
After=network.target redis-server.service redis.service

[Service]
Type=simple
# Replace with your Linux user (run `whoami`). Do NOT run as root.
User=<REPLACE_USER>
Group=<REPLACE_USER>
EnvironmentFile=/etc/default/celery
# Replace with the project folder containing manage.py.
WorkingDirectory=<REPLACE: /full/path/to/backend>
RuntimeDirectory=celery
LogsDirectory=celery
ExecStart=/bin/sh -c '${CELERY_BIN} -A ${CELERY_APP} beat \
    --loglevel=${CELERYD_LOG_LEVEL} \
    --pidfile=${CELERYBEAT_PID_FILE} \
    --logfile=${CELERYBEAT_LOG_FILE} \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
